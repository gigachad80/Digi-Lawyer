# Copy this file to .env and fill in your key.
# Get a key at https://aistudio.google.com/apikey

GOOGLE_API_KEY=

# Stable GA model as of July 2026. Fallbacks (gemini-3.5-flash, gemini-2.5-flash)
# are tried automatically if this model is ever deprecated or rate-limited.
GEMINI_MODEL=gemini-3.6-flash

# RAG chunking settings (word counts)
CHUNK_SIZE=250
OVERLAP_SIZE=40

APP_NAME=CyberLex AI Assistant
